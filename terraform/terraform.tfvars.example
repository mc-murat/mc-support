# Kopiere diese Datei nach terraform.tfvars und passe die Werte an.
# terraform.tfvars wird von Git ignoriert (enthält ggf. sensitive Werte).

aws_region       = "us-east-1"
instance_type    = "t3.micro"
key_pair_name    = "mein-schluessel"
allowed_ssh_cidr = "0.0.0.0/0"   # In Produktion: eigene IP eintragen, z. B. "203.0.113.10/32"
environment      = "dev"
